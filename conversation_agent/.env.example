# Conversation Design Assistant - Environment Variables
# Copy this file to .env and fill in your credentials.
# The .env file is gitignored and will never be committed.

# 🔑 IBM watsonx.ai (standard IBM Cloud IAM - RECOMMENDED) ──────────────────
# Get your API key at: cloud.ibm.com → Manage → Access → API keys → Create
# This is the standard credential for watsonx.ai on IBM Cloud.
WATSONX_IAM_APIKEY=

# watsonx.ai project ID - find at dataplatform.cloud.ibm.com → Your project → Manage tab
WATSONX_PROJECT_ID=

# Standard watsonx.ai endpoint (pick the region closest to you)
# us-south: https://us-south.ml.cloud.ibm.com
# eu-de:    https://eu-de.ml.cloud.ibm.com
# jp-tok:   https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# 🔑 IBM Watson Orchestrate (legacy - only needed for WO SSO deployments) ───
# Personal API key (ZenApiKey format) - leave blank if using IAM key above.
WATSONX_API_KEY=

# Session Bearer token - copy from browser DevTools; expires in 8-24 h.
# Leave blank if using a standard IBM Cloud IAM key above.
WATSONX_BEARER_TOKEN=

# 🔧 Mock mode ────────────────────────────────────────────────────────────────
# true  = bypass all live API calls (watsonx + MCP); use realistic mock data.
# false = use real credentials above (WATSONX_IAM_APIKEY + WATSONX_URL required).
MOCK_MODE=true

# 🔑 Google Developer Knowledge MCP ─────────────────────────────────────────
# Required for Google product queries (Android, Firebase, GCP, Gemini, etc.)
# This is a static API key — no expiry, no gcloud CLI, no billing required.
#
# How to get it (takes 30 seconds):
#   1. Go to https://aistudio.google.com/apikey
#   2. Sign in with any Google account
#   3. Click "Create API key" → copy the key
#
# Used in two places:
#   a) Here in .env for local testing via retrieval_agent.py
#   b) In watsonx Orchestrate Agent Builder as the x-goog-api-key header
#      when registering the google_developer_search MCP tool
GOOGLE_API_KEY=

# 🔧 MS Learn MCP ─────────────────────────────────────────────────────────────
# No API key required - public endpoint. Session ID managed automatically.
# MCP_BASE_URL=https://learn.microsoft.com/api/mcp

# 🔧 watsonx Orchestrate (Flask proxy) ───────────────────────────────────────
# Required for orchestrate/app.py (Flask middleware proxy).
#
# ORCHESTRATE_INSTANCE_URL
#   This is the Watson Assistant REST API host - NOT the Orchestrate web UI.
#   The web UI lives at:  https://<region>.dl.watson-orchestrate.ibm.com   WRONG
#   The API host is:      https://api.<region>.assistant.watson.cloud.ibm.com   CORRECT
#
#   Where to find it:
#     Orchestrate > Deploy > your published agent > View API details
#     Copy the value labelled "Assistant URL" or "Service instance URL".
#
#   Examples by region:
#     eu-de:    https://api.eu-de.assistant.watson.cloud.ibm.com
#     eu-gb:    https://api.eu-gb.assistant.watson.cloud.ibm.com
#     us-south: https://api.us-south.assistant.watson.cloud.ibm.com
#     au-syd:   https://api.au-syd.assistant.watson.cloud.ibm.com
ORCHESTRATE_INSTANCE_URL=

# IAM API key or ZenApiKey - find in IBM Cloud > Manage > Access > API keys
ORCHESTRATE_API_KEY=

# Agent/Assistant ID - find in Orchestrate > Deploy > your published agent > View API details
ORCHESTRATE_AGENT_ID=

# Agent Environment ID - find in Orchestrate > Deploy > Embed > agentEnvironmentId
AGENT_ENV_ID=

# Orchestration ID - find in Orchestrate > Deploy > Embed > orchestrationID
ORCHESTRATION_ID=

# Watson Orchestrate web host - the domain that serves wxoLoader.js.
# Format: https://<region>.dl.watson-orchestrate.ibm.com
# Derived automatically from ORCHESTRATE_INSTANCE_URL if left blank.
# Set explicitly if auto-derivation fails (e.g. eu-central-1 region):
#   HOST_URL=https://eu-central-1.dl.watson-orchestrate.ibm.com
HOST_URL=