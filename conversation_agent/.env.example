# Intently — Environment Variables
# Copy this file to .env and fill in your credentials.
# The .env file is gitignored and will never be committed.

# ── IBM watsonx.ai (standard IBM Cloud IAM — RECOMMENDED) ────────────────────
# Get your API key at: cloud.ibm.com → Manage → Access → API keys → Create
# This is the standard credential for watsonx.ai on IBM Cloud.
WATSONX_IAM_APIKEY=

# watsonx.ai project ID — find at dataplatform.cloud.ibm.com → Your project → Manage tab
WATSONX_PROJECT_ID=

# Standard watsonx.ai endpoint (pick the region closest to you)
# us-south: https://us-south.ml.cloud.ibm.com
# eu-de:    https://eu-de.ml.cloud.ibm.com
# jp-tok:   https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── IBM Watson Orchestrate (legacy — only needed for WO SSO deployments) ──────
# Personal API key (ZenApiKey format) — leave blank if using IAM key above.
WATSONX_API_KEY=

# Session Bearer token — copy from browser DevTools; expires in 8–24 h.
# Leave blank if using a standard IBM Cloud IAM key above.
WATSONX_BEARER_TOKEN=

# ── Mock mode ─────────────────────────────────────────────────────────────────
# true  = bypass all live API calls (watsonx + MCP); use realistic mock data.
# false = use real credentials above (WATSONX_IAM_APIKEY + WATSONX_URL required).
MOCK_MODE=true

# ── Google Developer Knowledge MCP ───────────────────────────────────────────
# Required for Google product queries (Android, Firebase, GCP, Gemini, etc.)
# This is a static API key — no expiry, no gcloud CLI, no billing required.
#
# How to get it (takes 30 seconds):
#   1. Go to https://aistudio.google.com/apikey
#   2. Sign in with any Google account
#   3. Click "Create API key" → copy the key
#
# Used in two places:
#   a) Here in .env for local testing via retrieval_agent.py
#   b) In watsonx Orchestrate Agent Builder as the x-goog-api-key header
#      when registering the google_developer_search MCP tool
GOOGLE_API_KEY=

# ── MS Learn MCP ──────────────────────────────────────────────────────────────
# No API key required — public endpoint. Session ID managed automatically.
# MCP_BASE_URL=https://learn.microsoft.com/api/mcp

# ── watsonx Orchestrate embed UI (orchestrate/app.py + ui.html) ──────────────
# Find all values in: IBM Cloud WXO > Deploy > your agent > Embed snippet
#
# hostURL from the embed snippet — e.g. https://eu-de.watson-orchestrate.cloud.ibm.com
HOST_URL=

# orchestrationID from the embed snippet
ORCHESTRATION_ID=

# crn from the embed snippet — auto-derived from HOST_URL + ORCHESTRATION_ID if left blank
# WXO_CRN=

# agentId from chatOptions in the embed snippet
ORCHESTRATE_AGENT_ID=

# agentEnvironmentId from chatOptions in the embed snippet
AGENT_ENV_ID=

# ── IAM authentication ────────────────────────────────────────────────────────
# Required for BOTH the embed UI (iamApikey) and the REST proxy.
# Use your IBM Cloud IAM API key: cloud.ibm.com → Manage → Access → API keys
# ORCHESTRATE_API_KEY is used first; WATSONX_IAM_APIKEY is the fallback.
ORCHESTRATE_API_KEY=

# ── Watson Assistant REST API (orchestrate/app.py proxy) ─────────────────────
# The REST API host for your Watson Assistant / WXO instance.
# Auto-derived from HOST_URL (eu-de → api.eu-de.assistant.watson.cloud.ibm.com)
# Set explicitly if auto-derivation is wrong:
#   IBM Cloud → Resource list → Watson Assistant → Service credentials → url
#   Examples: https://api.eu-de.assistant.watson.cloud.ibm.com
#             https://api.us-south.assistant.watson.cloud.ibm.com
ORCHESTRATE_INSTANCE_URL=

# ── Deployment ────────────────────────────────────────────────────────────────
# Public HTTPS URL of this server — used for CORS and the /health self-reference.
# Production (IBM Code Engine):
APP_URL=https://cda-app.2d591frd9jfp.eu-de.codeengine.appdomain.cloud
# Local dev: http://localhost:8000 or http://localhost:5001
#
# Add extra allowed CORS origins (comma-separated) — leave blank for defaults only:
# APP_EXTRA_ORIGINS=https://my-other-domain.com
