# Conversation Design Assistant — Environment Variables
# Copy this file to .env and fill in your credentials.
# The .env file is gitignored and will never be committed.

# ── IBM Watson Orchestrate / watsonx.ai ───────────────────────────────────────
# Personal API key (ZenApiKey format for Watson Orchestrate, or IBM Cloud IAM key)
WATSONX_API_KEY=

# Watson Orchestrate project / space ID
WATSONX_PROJECT_ID=

# Service endpoint URL
# Watson Orchestrate: https://api.<region>.dl.watson-orchestrate.ibm.com/instances/<id>
# watsonx.ai (standard): https://us-south.ml.cloud.ibm.com
WATSONX_URL=

# Session Bearer token — for Watson Orchestrate SSO deployments only.
# Copy from browser DevTools (F12 -> Network -> any request -> Authorization header).
# Expires after 8–24 hours. Leave blank if using a standard IBM Cloud IAM key.
WATSONX_BEARER_TOKEN=

# ── Mock mode ─────────────────────────────────────────────────────────────────
# true  = bypass all live API calls (watsonx + MCP); use realistic mock data.
# false = use real credentials above.
MOCK_MODE=true

# ── MS Learn MCP ──────────────────────────────────────────────────────────────
# No API key required — public endpoint. Session ID managed automatically.
# MCP_BASE_URL=https://learn.microsoft.com/api/mcp
